            "hash": "fda98422567b9750105a7b034910859aa1dfc7e1d5f40dcb6af1c0587dc1f851"
        },
        "32bit": {
            "url": "https://dl.google.com/release2/chrome/ackgyrjejfp6valrmwictuuqsbia_160.0.8178.0/160.0.8178.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "6302197c4eb83a8dadc154b4e605771ba5b6f9e5013e703baaa1921948adea19"
        },
        "arm64": {
            "url": "https://dl.google.com/release2/chrome/aduiyomyrxriojnd6grfjoswcwra_160.0.8178.0/160.0.8178.0_chrome_installer_uncompressed.exe#/dl.7z",
            "hash": "bcc5ac77bf909dbafccea99ca207aa0a012b22de381d4ee023ef4b96e0235107"
